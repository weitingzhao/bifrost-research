[sqlfluff]
dialect = postgres
# Jinja with dbt's builtins (ref, source, config, is_incremental, this) and our
# own macros/, so the lint needs no profile, no database and no `dbt deps`: the
# same verdict on a laptop and in the CI python gate. The models use nothing
# from dbt_utils or elementary; a model that does will fail to template here.
templater = jinja
# Explicit rule set: sqlfluff's curated `core` plus the rules listed below,
# each added on purpose; widen it the same way, not by upgrade.
# RF02 (added 2026-09-26): qualify columns wherever a select sees more than one
# table, scalar subqueries included. An unqualified column there binds to the
# innermost scope that has it, so if that table ever loses the column it quietly
# binds to the outer one instead of failing.
# AM03 (added 2026-09-26): an ORDER BY that gives any column a direction gives
# every column one, so `order by symbol, trade_date desc` cannot be misread as
# descending on both.
# RF03 (added 2026-09-26): a single-table select qualifies all of its columns or
# none. It matters most in a correlated subquery, where the other table in play
# is the outer one: there, qualify every column rather than trust scope.
# AL01 (added 2026-09-26): table aliases say `as` (`from t as d`), so an alias
# cannot be mistaken for a table name or a missing comma.
# ST06 (added 2026-09-26): select targets go wildcards, then plain columns, then
# calculations. Its fix reorders columns, and a model's final select IS the
# table's column order: adding it reordered 14 tables (and screening_ranked,
# which selects * from composite_score). Every reader found then goes by column
# name. Before relying on column position anywhere (a UNION of `select *`, a
# tuple index, a view over `*`), expect this rule to have moved things.
# ST07 (added 2026-09-26): joins name their keys with ON, not USING. Fix by
# hand: USING merges the key into one column, so the rewrite must keep what
# `select *`, an unqualified key and a FULL JOIN (coalesced key) would see.
# The 11 USING joins then were inner/left chains on symbol with every select
# qualified; each became `on <first table>.symbol = <joined>.symbol`, and
# EXPLAIN (VERBOSE) on the replica gave byte-identical plans before and after.
rules = core,RF02,AM03,RF03,AL01,ST06,ST07
# Same width as ruff's line-length.
max_line_length = 100

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = macros
